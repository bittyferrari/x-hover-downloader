{
  "manifest_version": 3,
  "name": "X Image & Video Downloader",
  "version": "2.3",
  "description": "Quickly hover on/off an X (Twitter) image or video twice within 2 seconds to auto-download it — images at original size, videos at the highest quality. Hover a photo to see it enlarged in a fixed, user-positioned preview box, and press your own hotkey to save it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://*.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
